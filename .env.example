# SYNTHETIC LOCAL DEVELOPMENT ONLY. Never deploy these credentials.
# Compose does not export either database port. Run DB commands with compose exec.
POSTGRES_DB=iam_platform
POSTGRES_USER=iam_user
POSTGRES_PASSWORD=dev_password_change_me
KEYCLOAK_DB_PASSWORD=keycloak_dev_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_CLIENT_ID=iam-backend
# Must match the synthetic realm import; changing .env alone does not rotate it.
KEYCLOAK_CLIENT_SECRET=dev-client-secret-change-me
KEYCLOAK_ADMIN_CLIENT_ID=iam-provider-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-provider-admin-secret
JWT_ISSUER=http://localhost:8180/realms/iam-platform
JWT_AUDIENCE=iam-backend
JWKS_URL=http://localhost:8180/realms/iam-platform/protocol/openid-connect/certs
KEYCLOAK_INTERNAL_URL=http://localhost:8180
KEYCLOAK_INTROSPECTION=true
KEYCLOAK_ALLOWED_AZP=iam-web,iam-mobile,iam-test
BACKEND_PORT=3100
BACKEND_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# DATABASE_URL is supplied by compose, targeting its private postgres service.
# Password grant is disabled in the import. Only explicitly gated local tests enable it.
IAM_ALLOW_PASSWORD_GRANT_TESTS=false
