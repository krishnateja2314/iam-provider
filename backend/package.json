{
  "name": "iam-platform-backend",
  "version": "1.0.0",
  "description": "Secure Multi-Tenant Identity, Authorization and Enterprise Access Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "setup": "npm run migrate && npm run seed",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:security": "vitest run --dir tests/security",
    "test:integration": "vitest run --dir tests/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "casbin": "5.51.1",
    "dotenv": "16.4.5",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "pino": "9.3.2",
    "uuid": "14.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "csv-parse": "7.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/uuid": "10.0.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.5.4",
    "vitest": "5.0.3"
  }
}
